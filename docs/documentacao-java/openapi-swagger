components:
  schemas:
    AtualizarAtendimentoDTO:
      type: object
      properties:
        prontuario:
          type: string
        idColaborador:
          type: integer
          format: int64
    AtualizarBeneficiarioDTO:
      type: object
      properties:
        telefone:
          type: string
        email:
          type: string
        endereco:
          $ref: "#/components/schemas/EntradaEnderecoDTO"
    AtualizarColaboradorDTO:
      type: object
      properties:
        email:
          type: string
    AtualizarDentistaDTO:
      type: object
      properties:
        telefone:
          type: string
        email:
          type: string
        categoriaDentista:
          type: string
        idEspecialidade:
          type: integer
          format: int64
        disponivel:
          type: string
        endereco:
          $ref: "#/components/schemas/EntradaEnderecoDTO"
    AtualizarPedidoAjudaDTO:
      type: object
      properties:
        statusPedido:
          $ref: "#/components/schemas/StatusPedido"
        idDentista:
          type: integer
          format: int64
    Colaborador:
      type: object
      properties:
        id:
          type: integer
          format: int64
        cpf:
          type: string
        nomeCompleto:
          type: string
        dataNascimento:
          $ref: "#/components/schemas/LocalDate"
        dataContratacao:
          $ref: "#/components/schemas/LocalDate"
        email:
          type: string
    CriarAtendimentoDTO:
      type: object
      required:
      - prontuario
      - cpfBeneficiario
      properties:
        prontuario:
          type: string
          pattern: \S
        cpfBeneficiario:
          type: string
          pattern: \S
    CriarBeneficiarioDTO:
      type: object
      required:
      - idPedidoAjuda
      - idProgramaSocial
      properties:
        idPedidoAjuda:
          type: integer
          format: int64
        idProgramaSocial:
          type: integer
          format: int64
    CriarColaboradorDTO:
      type: object
      required:
      - nomeCompleto
      properties:
        cpf:
          type: string
          pattern: "^\\d{11}$"
        nomeCompleto:
          type: string
          pattern: \S
        dataNascimento:
          $ref: "#/components/schemas/LocalDate"
        dataContratacao:
          $ref: "#/components/schemas/LocalDate"
        email:
          type: string
    CriarDentistaDTO:
      type: object
      required:
      - croDentista
      - cpf
      - nomeCompleto
      - sexo
      - email
      - telefone
      - categoria
      - disponivel
      - endereco
      properties:
        croDentista:
          type: string
          pattern: "^(?i)[A-Z0-9-/ ]{3,10}$"
        cpf:
          type: string
          pattern: "^\\d{11}$"
        nomeCompleto:
          type: string
          pattern: \S
        sexo:
          type: string
          pattern: \S
        email:
          type: string
          pattern: \S
        telefone:
          type: string
          pattern: \S
        categoria:
          type: string
          pattern: \S
        idEspecialidade:
          type: integer
          format: int64
        disponivel:
          type: string
          pattern: \S
        endereco:
          $ref: "#/components/schemas/EntradaEnderecoDTO"
    CriarPedidoAjudaDTO:
      type: object
      required:
      - cpf
      - nome
      - dataNascimento
      - sexo
      - telefone
      - email
      - descricaoProblema
      - endereco
      properties:
        cpf:
          type: string
          pattern: "^\\d{11}$"
        nome:
          type: string
          pattern: \S
        dataNascimento:
          $ref: "#/components/schemas/LocalDate"
        sexo:
          type: string
          pattern: \S
        telefone:
          type: string
          pattern: \S
        email:
          type: string
          pattern: \S
        descricaoProblema:
          type: string
          pattern: \S
        endereco:
          $ref: "#/components/schemas/EntradaEnderecoDTO"
    EntradaEnderecoCompletoDTO:
      type: object
      properties:
        cep:
          type: string
        numero:
          type: string
        tipoEndereco:
          type: string
    EntradaEnderecoDTO:
      type: object
      properties:
        cep:
          type: string
        numero:
          type: string
    LocalDate:
      type: string
      format: date
      examples:
      - 2022-03-10
    StatusPedido:
      type: string
      enum:
      - PENDENTE
      - APROVADO
      - REJEITADO
  securitySchemes:
    SecurityScheme:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: Authentication
info:
  title: Raiz do Bem
  version: 1.0.0
  description: Projeto academico elaborado para o Challenge FIAP 2025-26
